<!DOCTYPE html>
<html lang="en">
  
<head>
    <%- include('./partials/head'); -%>
</head>
<body onload="startTime()">
    <%- include('./partials/header_sidebar'); -%>
    
    <div class="page-body">
      <div class="container-fluid">
        <div class="page-title">
          <div class="row">
            <div class="col-sm-6">
              <h3>Pending Zone Requests</h3>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/index"><i data-feather="home"></i></a></li>
                <li class="breadcrumb-item"><<%=lan.dashboard %></li>
                <li class="breadcrumb-item active">Zone Requests</li>
              </ol>
            </div>
          </div>
        </div>
      </div>
      <!-- Container-fluid starts-->
      <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card border-0" style="box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-radius: 12px;">
                    <div class="card-body">
                        <div class="table-responsive theme-scrollbar">
                            <table class="display" id="basic-1">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Driver</th>
                                        <th><%=lan.email %></th>
                                        <th><%=lan.phone_number %></th>
                                        <th>Current Zone(s)</th>
                                        <th>Requested Zone(s)</th>
                                        <th class="text-center"><%=lan.action %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% var i = 1 %>
                                    <% drivers.forEach((data) => { %>
                                        <tr>
                                            <td><%= i %></td>
                                            <td>
                                                <a href="/driver/profile/<%= data.id %>" class="d-flex align-items-center text-dark hover-opacity" style="text-decoration: none;">
                                                    <div class="avatar" style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; margin-right: 10px; border: 1px solid #eee;">
                                                        <img src="../../<%= data.profile_image || 'images/dashboard/default/profile.png' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                                                    </div>
                                                    <span class="f-w-600"><%= data.first_name %> <%= data.last_name %></span>
                                                </a>
                                            </td>
                                            <td><%= data.email %></td>
                                            <td><%= data.primary_ccode %> <%= data.primary_phoneNo %></td>
                                            <td>
                                                <span class="badge badge-light text-dark px-2 py-1"><%= data.current_zone_name || 'None' %></span>
                                            </td>
                                            <td>
                                                <span class="badge badge-warning text-dark px-2 py-1" style="background-color: #ffc107;"><%= data.pending_zone_name %></span>
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                <button type="button" class="btn btn-success px-3 py-1 b-r-5 f-12 f-w-600 d-inline-flex align-items-center btn-approve-zone" data-id="<%= data.id %>" data-bs-toggle="modal" data-bs-target="#approveZoneModal">
                                                    <i class="fa fa-check me-2"></i> Approve
                                                </button>
                                                <button type="button" class="btn btn-danger px-3 py-1 b-r-5 f-12 f-w-600 ms-1 d-inline-flex align-items-center btn-reject-zone" data-id="<%= data.id %>" data-bs-toggle="modal" data-bs-target="#rejectZoneModal">
                                                    <i class="fa fa-times me-2"></i> Reject
                                                </button>
                                            </td>
                                        </tr>
                                        <% i++ %>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      </div>
      <!-- Container-fluid Ends-->
    </div>

    <!-- Approve Zone Modal -->
    <div class="modal fade" id="approveZoneModal" tabindex="-1" role="dialog" aria-labelledby="approveZoneModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Approve Zone Request</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fa fa-check-circle text-success mb-3" style="font-size: 50px;"></i>
                    <p class="f-16 f-w-500">Are you sure you want to approve this zone request?</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-secondary px-4" type="button" data-bs-dismiss="modal">Cancel</button>
                    <a id="btnConfirmApprove" href="" class="btn btn-success px-4 text-white">Yes, Approve</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Zone Modal -->
    <div class="modal fade" id="rejectZoneModal" tabindex="-1" role="dialog" aria-labelledby="rejectZoneModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Zone Request</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="rejectZoneForm" method="post" action="">
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label f-w-600">Rejection Reason</label>
                            <textarea class="form-control" name="rejection_reason" placeholder="Enter reason for rejection" required style="height: 100px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        <button class="btn btn-danger" type="submit">Submit Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('./partials/footer'); -%>
    <%- include('./partials/script'); -%>
    
    <script>
        $(document).on('click', '.btn-approve-zone', function() {
            var driverId = $(this).data('id');
            $('#btnConfirmApprove').attr('href', '/driver/approve_zone/' + driverId);
        });

        $(document).on('click', '.btn-reject-zone', function() {
            var driverId = $(this).data('id');
            $('#rejectZoneForm').attr('action', '/driver/reject_zone/' + driverId);
        });
    </script>
  </body>
</html>
