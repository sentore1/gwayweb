    <style>
      .gods-eye-btn {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%) !important;
        color: #ffffff !important;
        border: none !important;
        padding: 10px 24px !important;
        font-weight: 700 !important;
        font-size: 14px !important;
        letter-spacing: 0.5px !important;
        border-radius: 12px !important;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4) !important;
        transition: all 0.3s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        position: relative !important;
        text-decoration: none !important;
        animation: godsEyePulse 1.8s infinite ease-in-out !important;
      }
      .gods-eye-btn::after {
        content: '';
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border-radius: 16px;
        border: 2px solid #7c3aed;
        animation: godsEyeRipple 1.8s infinite cubic-bezier(0.25, 0.46, 0.45, 0.94);
        pointer-events: none;
      }
      .gods-eye-btn:hover {
        transform: translateY(-2px) scale(1.06) !important;
        box-shadow: 0 10px 30px rgba(124, 58, 237, 0.7) !important;
        color: #ffffff !important;
      }
      .gods-eye-btn i {
        font-size: 16px;
        animation: eyePulse 1.2s infinite ease-in-out;
      }
      @keyframes godsEyePulse {
        0% {
          transform: scale(1);
          box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }
        50% {
          transform: scale(1.04);
          box-shadow: 0 6px 25px rgba(124, 58, 237, 0.7);
        }
        100% {
          transform: scale(1);
          box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }
      }
      @keyframes godsEyeRipple {
        0% {
          transform: scale(0.95);
          opacity: 0.9;
        }
        100% {
          transform: scale(1.25);
          opacity: 0;
        }
      }
      @keyframes eyePulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.8; }
      }
    </style>
</head>
