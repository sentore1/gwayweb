<!DOCTYPE html>
<html lang="en">
  
<head>
    <%- include('./partials/head'); -%>
    
</head>
<body onload="startTime()">
    <%- include('./partials/header_sidebar'); -%>
    
    <!-- tap on top starts-->

        <!-- Page Sidebar Ends-->
        <div class="page-body">
          <div class="container-fluid">
            <div class="page-title">
              <div class="row">
                <div class="col-sm-6">
                  <h3><%=lan.Running%> <%=lan.Rides%> <%=lan.List%></h3>
                </div>
                <div class="col-sm-6">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/index"><i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item"><%=lan.Dashboard%></li>
                    <li class="breadcrumb-item active"><%=lan.Running%> <%=lan.Rides%> <%=lan.List%></li>
                  </ol>
                </div>
              </div>
            </div>
          </div>
          <!-- Container-fluid starts-->
          <div class="container-fluid">
            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="card-body">
                            <%- include('./partials/table_skeleton'); -%>
                            <div class="real-table-wrapper dt-loading">
                                <div class="table-responsive theme-scrollbar">
                                    <table class="display" id="basic-1">
                                        <thead>
                                            <tr>
                                                <th><%= lan.number %></th>
                                                <th><%=lan.Rider%></th>
                                                <th><%=lan.Driver%></th>
                                                <th><%=lan.Pickup%> <%=lan.Location%></th>
                                                <th><%=lan.Destination%></th>
                                                <th><%=lan.Ride%> <%=lan.Fare%></th>
                                                <th><%=lan.Module%> <%=lan.Type%></th>
                                                <th><%=lan.Action%></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% var i = 1 %>
                                            <% rd.forEach((data) => { %>
                                                <tr>
                                                    <td><%= i %></td>
                                                    <td><%= data.cname %></td>
                                                    <td><%= data.dfname %> <%= data.dlname %></td>
                                                    <td>
                                                      <%= data.pic_address.length < 40 ? data.pic_address : data.pic_address.slice(0, 40) + '...' %>
                                                    </td>
                                                    <td>
                                                      <%= data.drop_address.length < 40 ? data.drop_address : data.drop_address.slice(0, 40) + '...' %>
                                                    </td>
                                                    <td class="invosymbol"><%= (data.final_price).toFixed(2) %></td>
                                                    <td><%= data.mode_title%></td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <a class="dropbtn btn-primary px-2 py-1 b-r-5 f-12 f-w-400" href="/rides/rdetail/<%= data.id %>" style="display: inline-block; vertical-align: middle;"><%=lan.Details%></a>
                                                        <a class="dropbtn btn-success px-2 py-1 b-r-5 f-12 f-w-400 ms-1" href="/public/track/<%= data.tracking_token %>" target="_blank" style="display: inline-block; vertical-align: middle;">
                                                            <i data-feather="map" style="width: 12px; height: 12px; stroke-width: 2.5px; vertical-align: -1px; margin-right: 2px;"></i>Track
                                                        </a>
                                                        <button class="dropbtn btn-warning px-2 py-1 b-r-5 f-12 f-w-400 ms-1" onclick="copyTrackingLink(this, '<%= data.tracking_token %>')" style="display: inline-block; vertical-align: middle; color: white; border: none; padding: 4px 8px;">
                                                            <i data-feather="copy" style="width: 12px; height: 12px; stroke-width: 2.5px; vertical-align: -1px; margin-right: 2px;"></i>Copy
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% i++ %>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
          </div>
          <!-- Container-fluid Ends-->
        </div>

    <%- include('./partials/footer'); -%>
    <%- include('./partials/script'); -%>
    <script>
      function copyTrackingLink(btn, token) {
          const url = window.location.origin + '/public/track/' + token;
          navigator.clipboard.writeText(url).then(() => {
              const originalHTML = btn.innerHTML;
              btn.innerHTML = '<i data-feather="check" style="width: 12px; height: 12px; stroke-width: 2.5px; vertical-align: -1px; margin-right: 2px;"></i>Copied!';
              btn.classList.replace('btn-warning', 'btn-success');
              if (typeof feather !== 'undefined') feather.replace();
              
              setTimeout(() => {
                  btn.innerHTML = originalHTML;
                  btn.classList.replace('btn-success', 'btn-warning');
                  if (typeof feather !== 'undefined') feather.replace();
              }, 2000);
          }).catch(err => {
              console.error('Could not copy tracking link: ', err);
          });
      }
    </script>
  </body>
</html>