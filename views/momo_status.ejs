<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Processing MoMo Payment…</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        .card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            padding: 40px 32px;
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        .spinner-wrap {
            width: 80px; height: 80px;
            margin: 0 auto 24px;
            position: relative;
        }
        .spinner-bg {
            width: 80px; height: 80px;
            border-radius: 50%;
            border: 6px solid #fde68a;
        }
        .spinner {
            position: absolute;
            top: 0; left: 0;
            width: 80px; height: 80px;
            border-radius: 50%;
            border: 6px solid transparent;
            border-top-color: #FFCC00;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .title   { font-size: 22px; font-weight: 700; color: #1e293b; margin-bottom: 10px; }
        .desc    { font-size: 14px; color: #64748b; line-height: 1.6; margin-bottom: 28px; }

        .phone-prompt {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 13px;
            color: #92400e;
            margin-bottom: 24px;
            line-height: 1.6;
        }
        .phone-prompt strong { font-weight: 700; }

        .progress-bar-wrap {
            background: #f1f5f9;
            border-radius: 999px;
            height: 6px;
            overflow: hidden;
            margin-bottom: 12px;
        }
        .progress-bar {
            height: 100%;
            background: #FFCC00;
            border-radius: 999px;
            width: 0%;
            transition: width .5s ease;
        }
        .progress-label { font-size: 12px; color: #94a3b8; margin-bottom: 24px; }

        .status-badge {
            display: inline-block;
            padding: 5px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            background: #f1f5f9;
            color: #64748b;
            margin-bottom: 20px;
        }
        .status-badge.pending    { background: #fef9c3; color: #854d0e; }
        .status-badge.success    { background: #dcfce7; color: #15803d; }
        .status-badge.failed     { background: #fee2e2; color: #b91c1c; }

        .btn-cancel {
            background: none;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            transition: border-color .2s;
        }
        .btn-cancel:hover { border-color: #94a3b8; color: #374151; }

        #errorSection { display: none; }
        .err-title { font-size: 18px; font-weight: 700; color: #b91c1c; margin-bottom: 8px; }
        .err-desc  { font-size: 14px; color: #64748b; margin-bottom: 20px; }

        .icon-fail {
            width: 60px; height: 60px;
            border-radius: 50%;
            background: #fee2e2;
            color: #b91c1c;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
        }
    </style>
</head>
<body>
    <div class="card">
        <!-- Polling UI -->
        <div id="pendingSection">
            <div class="spinner-wrap">
                <div class="spinner-bg"></div>
                <div class="spinner"></div>
            </div>
            <div class="title">Waiting for Payment</div>
            <div class="desc">A payment request has been sent to your MTN number. Please check your phone and approve the transaction.</div>

            <div class="phone-prompt">
                📱 <strong>Check your phone now.</strong><br>
                Accept the MoMo prompt to complete your payment of <strong><%= parseFloat(amount).toFixed(2) %> RWF</strong>.
            </div>

            <div class="progress-bar-wrap">
                <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-label" id="progressLabel">Checking status… (0 / 12)</div>

            <div class="status-badge pending" id="statusBadge">PENDING</div><br>

            <button class="btn-cancel" id="cancelBtn">Cancel</button>
        </div>

        <!-- Error / timeout UI -->
        <div id="errorSection">
            <div class="icon-fail">
                <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
            <div class="err-title" id="errTitle">Payment Failed</div>
            <div class="err-desc"  id="errDesc">The transaction was not completed. Please try again.</div>
            <button class="btn-cancel" onclick="window.history.back()">Go Back</button>
        </div>
    </div>

    <script>
        const referenceId   = '<%= referenceId %>';
        const uid           = '<%= uid %>';
        const amount        = '<%= amount %>';
        const redirectUrl   = '<%= redirect_url %>';

        const MAX_POLLS  = 12;   // 12 × 5 s = 60 s total
        const INTERVAL   = 5000; // 5 seconds
        let   pollCount  = 0;
        let   pollTimer  = null;

        const progressBar   = document.getElementById('progressBar');
        const progressLabel = document.getElementById('progressLabel');
        const statusBadge   = document.getElementById('statusBadge');
        const pendingSection = document.getElementById('pendingSection');
        const errorSection   = document.getElementById('errorSection');

        function showError(title, desc) {
            pendingSection.style.display = 'none';
            errorSection.style.display   = 'block';
            document.getElementById('errTitle').textContent = title;
            document.getElementById('errDesc').textContent  = desc;
        }

        function poll() {
            pollCount++;
            const pct = Math.min((pollCount / MAX_POLLS) * 100, 100);
            progressBar.style.width  = pct + '%';
            progressLabel.textContent = `Checking status… (${pollCount} / ${MAX_POLLS})`;

            fetch(`/payment/momo-check?referenceId=${referenceId}&uid=${uid}&amount=${encodeURIComponent(amount)}&redirect_url=${encodeURIComponent(redirectUrl)}`)
                .then(r => r.json())
                .then(data => {
                    statusBadge.textContent = data.status || 'PENDING';

                    if (data.status === 'SUCCESSFUL') {
                        clearInterval(pollTimer);
                        statusBadge.className = 'status-badge success';
                        window.location.href = data.redirect;

                    } else if (data.status === 'FAILED' || data.status === 'REJECTED') {
                        clearInterval(pollTimer);
                        statusBadge.className = 'status-badge failed';
                        window.location.href = data.redirect;

                    } else if (pollCount >= MAX_POLLS) {
                        clearInterval(pollTimer);
                        showError(
                            'Payment Timed Out',
                            'We did not receive a confirmation within 60 seconds. If you approved the prompt, your wallet will be credited shortly. Otherwise please try again.'
                        );
                    }
                })
                .catch(() => {
                    if (pollCount >= MAX_POLLS) {
                        clearInterval(pollTimer);
                        showError('Connection Error', 'Could not reach the payment server. Please check your connection and try again.');
                    }
                });
        }

        // Start polling after a short delay so the user can read the instructions
        pollTimer = setInterval(poll, INTERVAL);

        document.getElementById('cancelBtn').addEventListener('click', function() {
            clearInterval(pollTimer);
            window.location.href = `/payment/status_page?status=fail&transactionId=${referenceId}&amount=${encodeURIComponent(amount)}&redirect_url=${encodeURIComponent(redirectUrl)}`;
        });
    </script>
</body>
</html>
