<!DOCTYPE html>
<html lang="en">
  
<head>
    <%- include('./partials/head'); -%>
</head>
<body onload="startTime()">
    <%- include('./partials/header_sidebar'); -%>
    
    <div class="page-body">
      <div class="container-fluid">
        <div class="page-title">
          <div class="row">
            <div class="col-sm-6">
              <h3>Pending Driver Documents</h3>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/index"><i data-feather="home"></i></a></li>
                <li class="breadcrumb-item"><%=lan.dashboard %></li>
                <li class="breadcrumb-item active">Pending Documents</li>
              </ol>
            </div>
          </div>
        </div>
      </div>
      <!-- Container-fluid starts-->
      <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card border-0" style="box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-radius: 12px;">
                    <div class="card-body">
                        <div class="table-responsive theme-scrollbar">
                            <table class="display" id="basic-1">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Driver</th>
                                        <th><%=lan.email %></th>
                                        <th><%=lan.phone_number %></th>
                                        <th class="text-center">Pending Documents</th>
                                        <th class="text-center"><%=lan.action %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% var i = 1 %>
                                    <% drivers.forEach((data) => { %>
                                        <tr>
                                            <td><%= i %></td>
                                            <td>
                                                <a href="/driver/profile/<%= data.id %>" class="d-flex align-items-center text-dark hover-opacity" style="text-decoration: none;">
                                                    <div class="avatar" style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; margin-right: 10px; border: 1px solid #eee;">
                                                        <img src="../../<%= data.profile_image || 'images/dashboard/default/profile.png' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                                                    </div>
                                                    <span class="f-w-600"><%= data.first_name %> <%= data.last_name %></span>
                                                </a>
                                            </td>
                                            <td><%= data.email %></td>
                                            <td><%= data.primary_ccode %> <%= data.primary_phoneNo %></td>
                                            <td class="text-center">
                                                <span class="badge badge-warning text-dark px-3 py-1 f-12" style="font-weight: 600; border-radius: 20px;"><%= data.pending_docs_count %> Pending</span>
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                <a href="/driver/document/<%= data.id %>" class="btn btn-primary px-3 py-1 b-r-5 f-12 f-w-600 d-inline-flex align-items-center">
                                                    <i data-feather="id-card" style="width: 13px; height: 13px; margin-right: 5px;"></i> Review Documents
                                                </a>
                                            </td>
                                        </tr>
                                        <% i++ %>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      </div>
      <!-- Container-fluid Ends-->
    </div>

    <%- include('./partials/footer'); -%>
    <%- include('./partials/script'); -%>
  </body>
</html>
