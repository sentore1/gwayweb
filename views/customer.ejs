<!DOCTYPE html>
<html lang="en">
  
<head>
    <%- include('./partials/head'); -%>
</head>
<body onload="startTime()">
    <%- include('./partials/header_sidebar'); -%>
    
    <!-- tap on top starts-->

    <!-- Page Sidebar Ends-->
    <div class="page-body">
      <div class="container-fluid">
        <div class="page-title">
          <div class="row">
            <div class="col-sm-6">
              <h3><%=lan.customer%> <%=lan.list%></h3>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/index"><i data-feather="home"></i></a></li>
                <li class="breadcrumb-item"><%=lan.dashboard%></li>
                <li class="breadcrumb-item active"><%=lan.customer%> <%=lan.list%></li>
              </ol>
            </div>
          </div>
        </div>
      </div>
      <!-- Container-fluid starts-->
      <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card">
                    <% let permiss = per != "1" ? per.customer[1] : "1" %>
                    <% if(permiss == "1"){ %>
                    <div class="card-header d-flex justify-content-end pb-0">
                        <a class="btn btn-square btn-primary b-r-10" type="button" href="/customer/add"><%=lan.add%> <%=lan.customer%></a>
                    </div>
                    <% } %>
                    <div class="card-body">
                        <%- include('./partials/table_skeleton'); -%>
                        <div class="real-table-wrapper dt-loading">
                            <div class="table-responsive theme-scrollbar">
                                <table class="display" id="basic-1">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th><%=lan.name%></th>
                                            <th><%=lan.email%></th>
                                            <th><%=lan.phone_number%></th>
                                            <th><%=lan.status%></th>
                                            <th><%=lan.chat%></th>
                                            <% let permissions = per != "1" ? per.customer[2] : "1" %>
                                            <% if(permissions == "1"){ %>
                                            <th><%=lan.action%></th>
                                            <% } %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% var i = 1 %>
                                        <% customer_list.forEach((data) => { %>
                                            <tr>
                                                <td><%= i %></td>
                                                <td><%= data.name %></td>
                                                <td><%= data.email %></td>
                                                <td><%= data.country_code %> <%= data.phone %></td>
                                                <td>
                                                    <% if (data.status == '1') { %>
                                                        <span class="badge badge-success"><%=lan.active%></span>
                                                    <% } else { %>
                                                        <span class="badge badge-danger"><%=lan.deactive%></span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <span class="custom_tooltip">
                                                        <a href="/customer/chat/<%= data.id %>"><span class="badge badge-primary" style="padding: 4px 15px 4px 15px;"><i class="fa fa-comments-o f-18"></i></span></a>
                                                        <span class="tooltiptext" style="width: 120px; margin-left: -60px; padding: 5px; font-size: 11px; bottom: 135%;">Chat with Customer</span>
                                                    </span>
                                                </td>
                                                <% if(permissions == "1"){ %>
                                                <td> 
                                                    <ul class="action"> 
                                                        <li class="text-primary custom_tooltip"><a href="/customer/profile/<%= data.id %>"><i class="icon-user f-14"></i></a><span class="tooltiptext" style="width: 100px; margin-left: -50px; padding: 5px; font-size: 11px; bottom: 135%;">View Profile</span></li>
                                                        <li class="adjust-wallet custom_tooltip" style="margin-left: 8px; cursor: pointer;" data-id="<%= data.id %>" data-name="<%= data.name %>" data-wallet="<%= data.wallet %>"><a href="javascript:void(0)" style="color: #51bb25;"><i class="icon-wallet f-14"></i></a><span class="tooltiptext" style="width: 120px; margin-left: -60px; padding: 5px; font-size: 11px; bottom: 135%;">Recharge Wallet</span></li>
                                                        <li class="edit custom_tooltip" style="margin-left: 8px;"> <a href="/customer/edit/<%= data.id %>"><i class="icon-pencil-alt"></i></a><span class="tooltiptext" style="width: 100px; margin-left: -50px; padding: 5px; font-size: 11px; bottom: 135%;">Edit Customer</span></li>
                                                        <li class="delete custom_tooltip"><a href="/customer/delete/<%= data.id %>"><i class="icon-trash"></i></a><span class="tooltiptext" style="width: 100px; margin-left: -50px; padding: 5px; font-size: 11px; bottom: 135%;">Delete Customer</span></li>
                                                    </ul>
                                                </td>
                                                <% } %>
                                            </tr>
                                        <% i++ %>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      </div>
      <!-- Container-fluid Ends-->
    </div>

    <!-- Manual Recharge/Adjustment Modal -->
    <div class="modal fade" id="manualRechargeModal" tabindex="-1" role="dialog" aria-labelledby="manualRechargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="manualRechargeModalLabel">Wallet Manual Adjustment</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/customer/wallet_adjustment" method="post">
                    <div class="modal-body text-start">
                        <div class="row g-3">
                            <div class="col-12">
                                <h5 class="f-w-500">Current Balance: <span class="invosymbol" id="current_balance_text">0</span></h5>
                            </div>
                            <div class="col-12 form-group">
                                <label class="col-form-label">Adjustment Type</label>
                                <select class="form-control" name="adj_type" required>
                                    <option value="credit">Credit (Add Money)</option>
                                    <option value="debit">Debit (Deduct Money)</option>
                                </select>
                            </div>
                            <div class="col-12 form-group">
                                <label class="col-form-label">Amount</label>
                                <input class="form-control" type="number" step="0.01" name="amount" min="0.01" placeholder="Enter amount" required>
                            </div>
                            <div class="col-12 form-group">
                                <label class="col-form-label">Reason / Reference Note</label>
                                <textarea class="form-control" name="note" placeholder="e.g. Cash payment at office, Adjustment refund" required></textarea>
                            </div>
                            <input type="hidden" name="uid" id="adj_customer_id" value="">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        <button class="btn btn-primary" type="submit">Submit Adjustment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('./partials/footer'); -%>
    <%- include('./partials/script'); -%>
    <script>
        $(document).on("click", ".adjust-wallet", function(){
            let { id, name, wallet } = $(this).data();
            $("#adj_customer_id").val(id);
            $("#manualRechargeModalLabel").text("Wallet Manual Adjustment - " + name);
            $("#manualRechargeModal").modal("show");
            
            // Format current balance text with currency symbol
            let sym = $('#rate_sym').val();
            let pls = $('#rate_pla').val();
            let formatted = wallet;
            if(pls == 1){
                formatted = wallet + ' ' + sym;
            } else {
                formatted = sym + ' ' + wallet;
            }
            $("#current_balance_text").text(formatted);
        });
    </script>

</body>
</html>
