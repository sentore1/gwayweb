<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTN MoMo Payment</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        .card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            padding: 36px 32px;
            max-width: 420px;
            width: 100%;
        }
        .momo-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
        }
        .momo-logo {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: #FFCC00;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            font-weight: 900;
            color: #000;
            flex-shrink: 0;
        }
        .momo-title { font-size: 20px; font-weight: 700; color: #1e293b; }
        .momo-sub   { font-size: 13px; color: #64748b; margin-top: 2px; }

        .amount-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .amount-label { font-size: 13px; color: #92400e; font-weight: 500; }
        .amount-value { font-size: 24px; font-weight: 800; color: #92400e; }

        label { font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px; }
        .input-wrap { position: relative; margin-bottom: 20px; }
        .input-prefix {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            font-weight: 600;
            color: #6b7280;
        }
        input[type="tel"] {
            width: 100%;
            padding: 13px 14px 13px 52px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 16px;
            color: #1e293b;
            outline: none;
            transition: border-color .2s;
        }
        input[type="tel"]:focus { border-color: #FFCC00; }
        .hint { font-size: 12px; color: #94a3b8; margin-top: -14px; margin-bottom: 20px; }

        .btn-pay {
            width: 100%;
            padding: 15px;
            background: #FFCC00;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            color: #000;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
        }
        .btn-pay:hover   { opacity: .9; }
        .btn-pay:active  { transform: scale(.98); }
        .btn-pay:disabled { opacity: .6; cursor: not-allowed; }

        .secure-note {
            display: flex;
            align-items: center;
            gap: 6px;
            justify-content: center;
            margin-top: 16px;
            font-size: 12px;
            color: #94a3b8;
        }
        .error-msg {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #b91c1c;
            margin-bottom: 16px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="momo-header">
            <div class="momo-logo">M</div>
            <div>
                <div class="momo-title">MTN Mobile Money</div>
                <div class="momo-sub">Pay securely with MoMo Rwanda</div>
            </div>
        </div>

        <div class="amount-box">
            <span class="amount-label">Amount to pay</span>
            <span class="amount-value"><%= parseFloat(amount).toFixed(2) %> RWF</span>
        </div>

        <div class="error-msg" id="errorMsg"></div>

        <form id="momoForm" action="/payment/momo-initiate" method="POST">
            <input type="hidden" name="uid"          value="<%= uid %>">
            <input type="hidden" name="amount"       value="<%= amount %>">
            <input type="hidden" name="redirect_url" value="<%= redirect_url %>">

            <label for="phone">MTN Mobile Number</label>
            <div class="input-wrap">
                <span class="input-prefix">+250</span>
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="78 123 4567"
                    maxlength="12"
                    autocomplete="tel"
                    required
                >
            </div>
            <p class="hint">Enter your MTN Rwanda number. Country code +250 is added automatically.</p>

            <button type="submit" class="btn-pay" id="submitBtn">
                Pay with MoMo
            </button>
        </form>

        <div class="secure-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Secured by MTN MoMo Rwanda
        </div>
    </div>

    <script>
        const form   = document.getElementById('momoForm');
        const btn    = document.getElementById('submitBtn');
        const errBox = document.getElementById('errorMsg');
        const phoneInput = document.getElementById('phone');

        // Strip any non-digit characters as user types
        phoneInput.addEventListener('input', function() {
            this.value = this.value.replace(/\D/g, '');
        });

        form.addEventListener('submit', function(e) {
            const digits = phoneInput.value.replace(/\D/g, '');
            if (digits.length < 8 || digits.length > 9) {
                e.preventDefault();
                errBox.textContent = 'Please enter a valid MTN Rwanda number (8–9 digits after country code).';
                errBox.style.display = 'block';
                return;
            }
            errBox.style.display = 'none';
            btn.disabled = true;
            btn.textContent = 'Sending request…';
        });
    </script>
</body>
</html>
