<!DOCTYPE html>
<html lang="en">
  
<head>
    <%- include('./partials/frontend_head'); -%>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      /* ===== Login Page Professional Styles ===== */
      .zg-login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
        position: relative;
        overflow: hidden;
        font-family: 'Inter', 'Montserrat', sans-serif;
        padding: 20px 20px 100px;
      }

      /* Animated background shapes */
      .zg-login-page::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: 
          radial-gradient(ellipse at 20% 50%, rgba(120, 80, 255, 0.12) 0%, transparent 50%),
          radial-gradient(ellipse at 80% 20%, rgba(80, 200, 255, 0.10) 0%, transparent 50%),
          radial-gradient(ellipse at 60% 80%, rgba(255, 100, 150, 0.08) 0%, transparent 50%);
        animation: bgFloat 20s ease-in-out infinite;
      }

      @keyframes bgFloat {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        33% { transform: translate(30px, -30px) rotate(1deg); }
        66% { transform: translate(-20px, 20px) rotate(-1deg); }
      }

      /* Floating orbs */
      .zg-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.3;
        animation: orbFloat 15s ease-in-out infinite;
      }
      .zg-orb-1 {
        width: 300px; height: 300px;
        background: #7c3aed;
        top: 10%; left: 5%;
        animation-delay: 0s;
      }
      .zg-orb-2 {
        width: 250px; height: 250px;
        background: #3b82f6;
        bottom: 15%; right: 10%;
        animation-delay: -5s;
      }
      .zg-orb-3 {
        width: 200px; height: 200px;
        background: #06b6d4;
        top: 60%; left: 60%;
        animation-delay: -10s;
      }

      @keyframes orbFloat {
        0%, 100% { transform: translateY(0) translateX(0); }
        25% { transform: translateY(-40px) translateX(20px); }
        50% { transform: translateY(20px) translateX(-30px); }
        75% { transform: translateY(-20px) translateX(-10px); }
      }

      .zg-login-wrapper {
        width: 100%;
        max-width: 600px;
        z-index: 2;
        position: relative;
      }

      /* Main card */
      .zg-login-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 100%;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 
          0 25px 60px rgba(0, 0, 0, 0.3),
          0 0 0 1px rgba(255, 255, 255, 0.1),
          inset 0 1px 0 rgba(255, 255, 255, 0.6);
        padding: 44px 40px 36px;
        animation: cardSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(30px);
      }

      @keyframes cardSlideUp {
        to { opacity: 1; transform: translateY(0); }
      }

      /* Logo section */
      .zg-logo-section {
        text-align: center;
        margin-bottom: 8px;
      }
      .zg-logo-section img {
        max-height: 56px;
        max-width: 180px;
        object-fit: contain;
        margin-bottom: 6px;
        filter: drop-shadow(0 2px 8px rgba(0,0,0,0.08));
      }

      /* Heading */
      .zg-login-heading {
        text-align: center;
        margin-bottom: 28px;
      }
      .zg-login-heading h4 {
        font-size: 22px;
        font-weight: 700;
        color: #1e1b4b;
        margin: 0 0 4px;
        letter-spacing: -0.3px;
      }
      .zg-login-heading p {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
        font-weight: 400;
      }

      /* Form styles */
      .zg-form .zg-form-group {
        margin-bottom: 18px;
      }
      .zg-form .zg-form-group label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .zg-form .zg-input-wrap {
        position: relative;
      }
      .zg-form .zg-input-wrap i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 15px;
        transition: color 0.2s;
      }
      .zg-form .zg-input {
        width: 100%;
        padding: 12px 14px 12px 42px;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        color: #1f2937;
        background: #fafafa;
        transition: all 0.25s ease;
        outline: none;
      }
      .zg-form .zg-input:focus {
        border-color: #7c3aed;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
      }
      .zg-form .zg-input:focus + i,
      .zg-form .zg-input:focus ~ i {
        color: #7c3aed;
      }
      .zg-form .zg-input::placeholder {
        color: #c0c4cc;
      }

      /* Password toggle */
      .zg-pass-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #9ca3af;
        font-size: 13px;
        font-weight: 500;
        font-family: 'Inter', sans-serif;
        transition: color 0.2s;
        padding: 2px 4px;
      }
      .zg-pass-toggle:hover {
        color: #7c3aed;
      }

      /* Submit button */
      .zg-submit-btn {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 50%, #5b21b6 100%);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.35);
        letter-spacing: 0.3px;
        margin-top: 6px;
      }
      .zg-submit-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(124, 58, 237, 0.45);
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6d28d9 100%);
      }
      .zg-submit-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(124, 58, 237, 0.3);
      }

      /* Quick access divider */
      .zg-or-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 22px 0 16px;
      }
      .zg-or-divider::before,
      .zg-or-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
      }
      .zg-or-divider span {
        font-size: 11px;
        color: #9ca3af;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        white-space: nowrap;
      }

      /* Quick access buttons */
      .zg-quick-btns {
        display: flex;
        gap: 12px;
      }
      .zg-quick-btn {
        flex: 1;
        padding: 10px;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .zg-quick-btn i {
        font-size: 14px;
      }
      .zg-quick-btn:hover {
        border-color: #7c3aed;
        color: #7c3aed;
        background: #f8f7ff;
        transform: translateY(-1px);
        box-shadow: 0 3px 12px rgba(124, 58, 237, 0.1);
      }

      /* Footer text */
      .zg-login-footer {
        text-align: center;
        margin-top: 24px;
        font-size: 11px;
        color: rgba(255,255,255,0.4);
        position: relative;
        z-index: 2;
        animation: cardSlideUp 0.8s 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      /* ===== BOTTOM ROAD ANIMATION ===== */
      .zg-road-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
        z-index: 10;
        pointer-events: none;
        overflow: hidden;
      }

      /* Road surface */
      .zg-road {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 44px;
        background: linear-gradient(180deg, #2d2d3f 0%, #1a1a2e 100%);
        border-top: 2px solid #4a4a6a;
      }

      /* Road center dashed line */
      .zg-road::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 2px;
        transform: translateY(-50%);
        background: repeating-linear-gradient(
          90deg, 
          #f5c542 0px, #f5c542 20px, 
          transparent 20px, transparent 36px
        );
        animation: roadLineScroll 1.2s linear infinite;
      }

      @keyframes roadLineScroll {
        0% { transform: translateY(-50%) translateX(0); }
        100% { transform: translateY(-50%) translateX(-36px); }
      }

      /* Road edge lines */
      .zg-road::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-top: 2px solid rgba(255,255,255,0.15);
        border-bottom: 2px solid rgba(255,255,255,0.08);
      }

      /* Stop markers on the road */
      .zg-stops {
        position: absolute;
        bottom: 44px;
        left: 0;
        width: 100%;
        height: 36px;
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
        padding: 0 80px;
      }

      .zg-stop {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        animation: stopPulse 3s ease-in-out infinite;
      }
      .zg-stop:nth-child(2) { animation-delay: 0.5s; }
      .zg-stop:nth-child(3) { animation-delay: 1s; }
      .zg-stop:nth-child(4) { animation-delay: 1.5s; }
      .zg-stop:nth-child(5) { animation-delay: 2s; }

      @keyframes stopPulse {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
      }

      .zg-stop-label {
        font-size: 9px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.55);
        font-family: 'Inter', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
      }
      .zg-stop-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7c3aed;
        box-shadow: 0 0 8px rgba(124, 58, 237, 0.6), 0 0 20px rgba(124, 58, 237, 0.2);
        position: relative;
      }
      .zg-stop-dot::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 1.5px solid rgba(124, 58, 237, 0.35);
        transform: translate(-50%, -50%);
      }
      /* Pin connector line from dot to road */
      .zg-stop-pin {
        width: 1.5px;
        height: 10px;
        background: linear-gradient(180deg, rgba(124, 58, 237, 0.5), rgba(124, 58, 237, 0.1));
      }

      /* Dotted path connecting stops */
      .zg-path-line {
        position: absolute;
        bottom: 48px;
        left: 80px;
        right: 80px;
        height: 2px;
        background: repeating-linear-gradient(
          90deg, 
          rgba(124, 58, 237, 0.3) 0px, rgba(124, 58, 237, 0.3) 4px, 
          transparent 4px, transparent 10px
        );
      }

      /* Taxi car animation */
      .zg-taxi {
        position: absolute;
        bottom: 10px;
        left: -60px;
        animation: taxiDrive 12s linear infinite;
        z-index: 5;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
      }

      @keyframes taxiDrive {
        0% { left: -60px; }
        100% { left: 110%; }
      }

      /* Taxi SVG */
      .zg-taxi svg {
        width: 52px;
        height: 28px;
      }

      /* Taxi headlight glow */
      .zg-taxi::after {
        content: '';
        position: absolute;
        right: -12px;
        top: 8px;
        width: 20px;
        height: 10px;
        background: radial-gradient(ellipse at left, rgba(255, 230, 120, 0.5), transparent);
        border-radius: 50%;
      }

      /* Second taxi (slower, further behind) */
      .zg-taxi-2 {
        animation: taxiDrive2 18s linear infinite;
        animation-delay: 6s;
        opacity: 0.5;
        bottom: 22px;
      }
      .zg-taxi-2 svg {
        width: 38px;
        height: 20px;
      }

      @keyframes taxiDrive2 {
        0% { left: -50px; }
        100% { left: 110%; }
      }

      /* Responsive */
      @media (max-width: 520px) {
        .zg-login-card {
          padding: 32px 24px 28px;
          border-radius: 20px;
        }
        .zg-stops {
          padding: 0 30px;
        }
        .zg-path-line {
          left: 30px;
          right: 30px;
        }
        .zg-stop-label {
          font-size: 7px;
        }
      }

      /* Override theme defaults */
      .zg-login-page .login-card {
        all: unset;
      }
      .zg-login-page .login-main {
        all: unset;
      }
    </style>
</head>
<body onload="offdarkmode()">
  <!-- Loader starts-->
  <div class="loader-wrapper">
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"> </div>
    <div class="dot"></div>
  </div>
  <!-- Loader ends-->

  <!-- Login page start -->
  <div class="zg-login-page">
    <!-- Background orbs -->
    <div class="zg-orb zg-orb-1"></div>
    <div class="zg-orb zg-orb-2"></div>
    <div class="zg-orb zg-orb-3"></div>

    <div class="zg-login-wrapper">
      <!-- Main login card -->
      <div class="zg-login-card">

        <!-- Logo -->
        <% if (general && general.light_image) { %>
        <div class="zg-logo-section">
          <img src="../../<%= general.light_image %>" alt="<%= general.title || 'Logo' %>">
        </div>
        <% } %>

        <!-- Heading -->
        <div class="zg-login-heading">
          <h4>Welcome Back</h4>
          <p>Sign in to your dashboard</p>
        </div>

        <!-- Login form -->
        <form class="zg-form theme-form" action="/login" method="post">
          <div class="zg-form-group">
            <label>Email</label>
            <div class="zg-input-wrap">
              <input class="zg-input form-control" type="email" name="email" placeholder="Enter your email" required>
              <i class="fa fa-envelope-o"></i>
            </div>
          </div>

          <div class="zg-form-group">
            <label>Password</label>
            <div class="zg-input-wrap">
              <input class="zg-input form-control" type="password" name="password" id="zg-password" placeholder="Enter your password" required>
              <i class="fa fa-lock"></i>
              <button type="button" class="zg-pass-toggle" onclick="togglePassword()">show</button>
            </div>
          </div>

          <button class="zg-submit-btn" type="submit">
            Sign In
          </button>

          <div class="zg-or-divider">
            <span>Quick Access</span>
          </div>

          <div class="zg-quick-btns">
            <button type="button" class="zg-quick-btn" id="login_admin">
              <i class="fa fa-user-secret"></i> Admin
            </button>
            <button type="button" class="zg-quick-btn" id="login_role">
              <i class="fa fa-users"></i> Role
            </button>
          </div>
        </form>
      </div>

      <!-- Footer -->
      <div class="zg-login-footer">
        &copy; <%= new Date().getFullYear() %> <%= general && general.title ? general.title : 'Dashboard' %>. All rights reserved.
      </div>
    </div>

    <!-- ===== Bottom Road Animation ===== -->
    <div class="zg-road-container">
      <!-- Dotted path above road connecting stops -->
      <div class="zg-path-line"></div>

      <!-- Stop markers -->
      <div class="zg-stops">
        <div class="zg-stop">
          <span class="zg-stop-label">Pickup</span>
          <div class="zg-stop-dot"></div>
          <div class="zg-stop-pin"></div>
        </div>
        <div class="zg-stop">
          <span class="zg-stop-label">Stop 1</span>
          <div class="zg-stop-dot"></div>
          <div class="zg-stop-pin"></div>
        </div>
        <div class="zg-stop">
          <span class="zg-stop-label">Stop 2</span>
          <div class="zg-stop-dot"></div>
          <div class="zg-stop-pin"></div>
        </div>
        <div class="zg-stop">
          <span class="zg-stop-label">Stop 3</span>
          <div class="zg-stop-dot"></div>
          <div class="zg-stop-pin"></div>
        </div>
        <div class="zg-stop">
          <span class="zg-stop-label">Drop</span>
          <div class="zg-stop-dot"></div>
          <div class="zg-stop-pin"></div>
        </div>
      </div>

      <!-- Road surface -->
      <div class="zg-road"></div>

      <!-- Taxi 1 (main, front lane) -->
      <div class="zg-taxi">
        <svg viewBox="0 0 120 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Car body -->
          <rect x="10" y="25" width="100" height="24" rx="6" fill="#f5c542"/>
          <rect x="12" y="27" width="96" height="20" rx="5" fill="#e8b730"/>
          <!-- Roof / cabin -->
          <path d="M35 25 L45 8 L85 8 L95 25" fill="#f5c542" stroke="#d4a020" stroke-width="1"/>
          <path d="M37 25 L46 10 L84 10 L93 25" fill="#ffeaa0"/>
          <!-- Windows -->
          <rect x="48" y="11" width="14" height="12" rx="2" fill="#87ceeb" opacity="0.85"/>
          <rect x="66" y="11" width="14" height="12" rx="2" fill="#87ceeb" opacity="0.85"/>
          <!-- Window divider -->
          <line x1="64" y1="11" x2="64" y2="23" stroke="#d4a020" stroke-width="1.5"/>
          <!-- Taxi sign on roof -->
          <rect x="57" y="2" width="20" height="7" rx="3" fill="#fff" stroke="#d4a020" stroke-width="0.8"/>
          <text x="67" y="7.5" font-size="4.5" fill="#d4a020" text-anchor="middle" font-weight="bold" font-family="Inter, sans-serif">TAXI</text>
          <!-- Headlights -->
          <circle cx="108" cy="35" r="3" fill="#fff9c4" opacity="0.9"/>
          <circle cx="108" cy="35" r="5" fill="#fff9c4" opacity="0.3"/>
          <!-- Tail lights -->
          <circle cx="12" cy="35" r="2.5" fill="#ef4444" opacity="0.8"/>
          <!-- Wheels -->
          <circle cx="32" cy="49" r="8" fill="#333"/>
          <circle cx="32" cy="49" r="5" fill="#555"/>
          <circle cx="32" cy="49" r="2" fill="#888"/>
          <circle cx="88" cy="49" r="8" fill="#333"/>
          <circle cx="88" cy="49" r="5" fill="#555"/>
          <circle cx="88" cy="49" r="2" fill="#888"/>
          <!-- Door handle -->
          <rect x="55" y="32" width="8" height="1.5" rx="0.75" fill="#d4a020"/>
          <!-- Bumper detail -->
          <rect x="100" y="40" width="12" height="3" rx="1.5" fill="#d4a020" opacity="0.6"/>
          <rect x="4" y="40" width="10" height="3" rx="1.5" fill="#d4a020" opacity="0.6"/>
        </svg>
      </div>

      <!-- Taxi 2 (background, smaller, slower) -->
      <div class="zg-taxi zg-taxi-2">
        <svg viewBox="0 0 120 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="10" y="25" width="100" height="24" rx="6" fill="#a0a0c0"/>
          <rect x="12" y="27" width="96" height="20" rx="5" fill="#8888aa"/>
          <path d="M35 25 L45 8 L85 8 L95 25" fill="#a0a0c0" stroke="#7a7a9a" stroke-width="1"/>
          <path d="M37 25 L46 10 L84 10 L93 25" fill="#c0c0d8"/>
          <rect x="48" y="11" width="14" height="12" rx="2" fill="#87ceeb" opacity="0.6"/>
          <rect x="66" y="11" width="14" height="12" rx="2" fill="#87ceeb" opacity="0.6"/>
          <circle cx="108" cy="35" r="3" fill="#fff9c4" opacity="0.5"/>
          <circle cx="12" cy="35" r="2.5" fill="#ef4444" opacity="0.4"/>
          <circle cx="32" cy="49" r="8" fill="#333"/>
          <circle cx="32" cy="49" r="5" fill="#555"/>
          <circle cx="88" cy="49" r="8" fill="#333"/>
          <circle cx="88" cy="49" r="5" fill="#555"/>
        </svg>
      </div>
    </div>
  </div>
  <!-- Login page end -->

  <%- include('./partials/script'); -%>

  <script>
    function togglePassword() {
      var passInput = document.getElementById('zg-password');
      var toggleBtn = event.target;
      if (passInput.type === 'password') {
        passInput.type = 'text';
        toggleBtn.textContent = 'hide';
      } else {
        passInput.type = 'password';
        toggleBtn.textContent = 'show';
      }
    }
  </script>
</body>
</html>